// Fashion Commerce Platform - Prisma schema
// Covers Phase 1 (M00-M07): Foundation, Auth/RBAC, Product Master,
// Suppliers, Purchase Orders, GRN/QC, Inventory, Catalog/Pricing.
// Phase 2 (M08+) adds Tax & Invoicing Foundation and beyond.
//
// See ARCHITECTURE.md, ADR-0012 (inventory ledger), ADR-0016 (Medusa
// sequencing), and blueprint/DECISION_REGISTER.md for the decisions
// this schema implements.
//
// NOTE: migrations 20260922171222_add_integrity_constraints and
// 20260923000000_add_tax_invoicing_foundation also add hand-written
// CHECK constraints (non-negative/positive quantities and money,
// InventoryBalance.reserved <= onHand, GRN quantity-balance, Price
// sellingPrice <= mrp, Invoice/InvoiceLine/CreditNote/CreditNoteLine
// CGST+SGST vs IGST mutual exclusivity, effective-date window sanity)
// that are NOT representable in this DSL and so have no corresponding
// attribute here. Read those migration files before assuming the schema
// below is the complete set of database-level invariants.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// M00: Organization & Locations (specs/31-organization-locations.md)
// ---------------------------------------------------------------------------

model Brand {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  styles Style[]

  @@map("brands")
}

enum LocationType {
  WAREHOUSE
  STORE // reserved for FUTURE_CONSIDERATION (physical stores) - not used in Phase 1
}

model Location {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String
  type              LocationType @default(WAREHOUSE)
  isActive          Boolean      @default(true)
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pinCode           String?
  gstRegistrationId String? // M08: which GST registration supplies from this location (TAX-001); nullable until configured
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  gstRegistration GstRegistration? @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)

  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  inventoryBalances    InventoryBalance[]
  inventoryTxns        InventoryTransaction[]
  transfersFrom        InventoryTransfer[]    @relation("TransferFrom")
  transfersTo          InventoryTransfer[]    @relation("TransferTo")
  checkoutSessionLines CheckoutSessionLine[]
  orderLines           OrderLine[]
  pickTasks            PickTask[]
  returnLines          ReturnLine[]
  exchanges            Exchange[]

  @@index([gstRegistrationId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// M01: Authentication & RBAC (specs/01-auth-rbac.md)
// ---------------------------------------------------------------------------

model Customer {
  id               String    @id @default(uuid())
  mobile           String    @unique
  email            String?
  fullName         String?
  mobileVerifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens      CustomerRefreshToken[]
  reviews            Review[]
  cart               Cart?
  wishlist           Wishlist?
  checkoutSessions   CheckoutSession[]
  orders             Order[]
  storeCreditAccount StoreCreditAccount?

  @@map("customers")
}

model OtpCode {
  id          String    @id @default(uuid())
  mobile      String
  codeHash    String
  purpose     String    @default("LOGIN")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([mobile, consumedAt])
  @@map("otp_codes")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

model StaffUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String? // TOTP secret, encrypted at rest by application layer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                   StaffUserRole[]
  sessions                StaffSession[]
  submittedPOs            PurchaseOrder[]         @relation("POSubmittedBy")
  approvedPOs             PurchaseOrder[]         @relation("POApprovedBy")
  poApprovalEvents        PurchaseOrderApproval[]
  receivedGRNs            GoodsReceipt[]          @relation("GRNReceivedBy")
  inventoryAdjustments    InventoryTransaction[]  @relation("InventoryAdjustmentActor")
  coApprovedAdjustments   InventoryTransaction[]  @relation("InventoryAdjustmentCoApprover")
  publishedStyles         Style[]                 @relation("StylePublishedBy")
  auditLogEntries         AuditLog[]
  moderatedShoppableMedia ShoppableMedia[]        @relation("ShoppableMediaModeratedBy")
  moderatedReviews        Review[]                @relation("ReviewModeratedBy")
  crossSellOverrides      CrossSellOverride[]
  pickedPickTasks         PickTask[]              @relation("PickTaskPickedBy")
  createdShipments        Shipment[]              @relation("ShipmentCreatedBy")
  initiatedReturns        Return[]                @relation("ReturnInitiatedBy")
  qcReturnLines           ReturnLine[]            @relation("ReturnLineQcBy")
  createdReturnPickups    ReturnPickup[]          @relation("ReturnPickupCreatedBy")
  initiatedRefunds        Refund[]                @relation("RefundInitiatedBy")
  storeCreditEntriesActed StoreCreditEntry[]      @relation("StoreCreditEntryActor")
  initiatedExchanges      Exchange[]              @relation("ExchangeInitiatedBy")
  qcExchanges             Exchange[]              @relation("ExchangeQcBy")

  @@map("staff_users")
}

model StaffSession {
  id          String    @id @default(uuid())
  staffUserId String
  tokenHash   String    @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_sessions")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. SUPER_ADMIN, BUYING, MERCHANDISING...
  name        String
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  staffUsers  StaffUserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "po:approve", "inventory:adjust"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StaffUserRole {
  staffUserId String
  roleId      String

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffUserId, roleId])
  @@map("staff_user_roles")
}

enum AuditActorType {
  STAFF
  CUSTOMER
  SYSTEM
}

model AuditLog {
  id           String         @id @default(uuid())
  actorType    AuditActorType
  actorStaffId String?
  action       String // e.g. "po.approve", "inventory.adjust", "style.publish"
  entityType   String
  entityId     String
  oldValue     Json?
  newValue     Json?
  reference    String?
  createdAt    DateTime       @default(now())

  // Explicitly Restrict, not Prisma's implicit SetNull default for a
  // nullable FK: the audit trail must never silently lose who
  // performed an action because that staff row was later deleted.
  actorStaff StaffUser? @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M02: Product Master (specs/02-product-master.md)
// ---------------------------------------------------------------------------

enum StyleLifecycleState {
  DRAFT
  READY_FOR_ENRICHMENT
  READY_FOR_QA
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?
  isActive Boolean @default(true)

  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryTree")
  styles       Style[]
  returnPolicy ReturnPolicy?

  @@map("categories")
}

model Style {
  id               String  @id @default(uuid())
  styleCode        String  @unique
  name             String
  brandId          String
  categoryId       String
  department       String? // e.g. Men, Women
  gender           String?
  division         String?
  subcategory      String?
  season           String // required (PROD-001)
  collection       String // required (PROD-001)
  fabric           String?
  fit              String?
  pattern          String?
  occasion         String?
  sleeve           String?
  neck             String?
  washCare         String?
  countryOfOrigin  String?
  hsnCode          String? // nullable pending TAX-003 verification
  customAttributes Json? // extensible attribute bag (PROD-001)

  lifecycleState     StyleLifecycleState @default(DRAFT)
  qaPassedAt         DateTime? // automated completeness gate (PROD-002/003)
  publishedAt        DateTime?
  publishedByStaffId String?

  // M10 search ranking (SRCH-001): manual merchandiser pin, boosted above
  // ordinary relevance/recency ranking in the Meilisearch index. Never set
  // by any automated/rule-based process - always an explicit staff action
  // (catalog:search:pin), mirroring the "no autonomous merchandising"
  // discipline used elsewhere (e.g. Watch & Shop's staff-only publishing).
  searchPinned   Boolean   @default(false)
  searchPinnedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand       Brand      @relation(fields: [brandId], references: [id])
  category    Category   @relation(fields: [categoryId], references: [id])
  publishedBy StaffUser? @relation("StylePublishedBy", fields: [publishedByStaffId], references: [id], onDelete: Restrict)

  colours            Colour[]
  skus               Sku[]
  media              ProductMedia[]
  prices             Price[]
  collections        CollectionStyle[]
  badges             MerchandiseBadge[]
  supplierSkus       SupplierSku[]
  shoppableMediaTags ShoppableMediaTag[]
  reviews            Review[]
  crossSellFrom      CrossSellOverride[] @relation("CrossSellFrom")
  crossSellTo        CrossSellOverride[] @relation("CrossSellTo")
  returnPolicy       ReturnPolicy?

  @@index([lifecycleState])
  @@index([brandId])
  @@index([categoryId])
  @@map("styles")
}

model Colour {
  id         String  @id @default(uuid())
  styleId    String
  name       String
  colourCode String
  hexSwatch  String?

  style              Style               @relation(fields: [styleId], references: [id], onDelete: Cascade)
  skus               Sku[]
  media              ProductMedia[]
  prices             Price[]
  shoppableMediaTags ShoppableMediaTag[]

  @@unique([styleId, colourCode])
  @@map("colours")
}

model Size {
  id        String @id @default(uuid())
  label     String @unique
  sortOrder Int    @default(0)

  skus               Sku[]
  shoppableMediaTags ShoppableMediaTag[]

  @@map("sizes")
}

model SizeChart {
  id            String    @id @default(uuid())
  name          String
  category      String? // scoping dimensions (PROD-004)
  gender        String?
  brandId       String?
  version       Int       @default(1)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  entries SizeChartEntry[]
  skus    Sku[]

  @@map("size_charts")
}

model SizeChartEntry {
  id           String @id @default(uuid())
  sizeChartId  String
  sizeLabel    String
  measurements Json

  sizeChart SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)

  @@unique([sizeChartId, sizeLabel])
  @@map("size_chart_entries")
}

model Sku {
  id          String   @id @default(uuid())
  skuCode     String   @unique
  barcode     String?  @unique
  styleId     String
  colourId    String
  sizeId      String
  sizeChartId String?
  hsnCode     String? // M08: per-SKU HSN override; falls back to Style.hsnCode when null (TAX-003)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  style     Style      @relation(fields: [styleId], references: [id])
  colour    Colour     @relation(fields: [colourId], references: [id])
  size      Size       @relation(fields: [sizeId], references: [id])
  sizeChart SizeChart? @relation(fields: [sizeChartId], references: [id])

  supplierSkus           SupplierSku[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceiptLines      GoodsReceiptLine[]
  inventoryBalances      InventoryBalance[]
  inventoryTxns          InventoryTransaction[]
  reservations           InventoryReservation[]
  transfers              InventoryTransfer[]
  invoiceLines           InvoiceLine[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]
  checkoutSessionLines   CheckoutSessionLine[]
  orderLines             OrderLine[]
  pickTasks              PickTask[]
  returnLines            ReturnLine[]
  exchangesAsOriginal    Exchange[]             @relation("ExchangeOriginalSku")
  exchangesAsReplacement Exchange[]             @relation("ExchangeReplacementSku")

  @@unique([styleId, colourId, sizeId])
  @@index([styleId])
  @@map("skus")
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductMedia {
  id          String    @id @default(uuid())
  styleId     String
  colourId    String? // null = applies to all colours; set = variant-specific imagery
  url         String
  type        MediaType @default(IMAGE)
  sortOrder   Int       @default(0)
  altText     String?
  isSwatch    Boolean   @default(false)
  seoMetadata Json?
  // M11 (PROD-005): optional model-measurements/model-worn-size enrichment,
  // e.g. {"height": "5'9\"", "bust": "34", "waist": "26", "wornSize": "M"}.
  // Never required, never fabricated - null when not captured by
  // merchandising, exactly reflecting what was actually entered.
  modelInfo   Json?
  createdAt   DateTime  @default(now())

  style  Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)
  colour Colour? @relation(fields: [colourId], references: [id], onDelete: Cascade)

  @@index([styleId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// M03: Suppliers (specs/03-suppliers-procurement.md)
// ---------------------------------------------------------------------------

enum SupplierType {
  FINISHED_GOODS
  MANUFACTURING
}

model Supplier {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  type         SupplierType
  contactName  String?
  contactEmail String?
  contactPhone String?
  paymentTerms String?
  leadTimeDays Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  supplierSkus   SupplierSku[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model SupplierSku {
  id          String   @id @default(uuid())
  supplierId  String
  skuId       String
  styleId     String
  cost        Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  isPreferred Boolean  @default(false)
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  sku      Sku      @relation(fields: [skuId], references: [id])
  style    Style    @relation(fields: [styleId], references: [id])

  @@unique([supplierId, skuId])
  @@map("supplier_skus")
}

// ---------------------------------------------------------------------------
// M04: Purchase Orders (specs/04-purchase-orders.md)
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                       String              @id @default(uuid())
  poNumber                 String              @unique
  supplierId               String
  locationId               String
  status                   PurchaseOrderStatus @default(DRAFT)
  submittedByStaffId       String?
  approvedByStaffId        String?
  approvalThresholdApplied Decimal?            @db.Decimal(12, 2)
  totalCost                Decimal             @default(0) @db.Decimal(14, 2)
  currency                 String              @default("INR")
  expectedDate             DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  location    Location   @relation(fields: [locationId], references: [id])
  submittedBy StaffUser? @relation("POSubmittedBy", fields: [submittedByStaffId], references: [id], onDelete: Restrict)
  approvedBy  StaffUser? @relation("POApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: Restrict)

  lines         PurchaseOrderLine[]
  approvals     PurchaseOrderApproval[]
  goodsReceipts GoodsReceipt[]

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String  @id @default(uuid())
  poId        String
  skuId       String
  orderedQty  Int
  unitCost    Decimal @db.Decimal(12, 2)
  receivedQty Int     @default(0)

  po  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  sku Sku           @relation(fields: [skuId], references: [id])

  goodsReceiptLines GoodsReceiptLine[]

  @@index([poId])
  @@map("purchase_order_lines")
}

enum POApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model PurchaseOrderApproval {
  id        String           @id @default(uuid())
  poId      String
  staffId   String
  action    POApprovalAction
  comment   String?
  createdAt DateTime         @default(now())

  po    PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  staff StaffUser     @relation(fields: [staffId], references: [id])

  @@index([poId])
  @@map("purchase_order_approvals")
}

// ---------------------------------------------------------------------------
// M05: GRN / QC (specs/05-grn.md)
// ---------------------------------------------------------------------------

enum GoodsReceiptStatus {
  OPEN
  CLOSED
}

model GoodsReceipt {
  id                String             @id @default(uuid())
  grnNumber         String             @unique
  poId              String
  locationId        String
  receivedByStaffId String
  status            GoodsReceiptStatus @default(OPEN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  po         PurchaseOrder @relation(fields: [poId], references: [id])
  location   Location      @relation(fields: [locationId], references: [id])
  receivedBy StaffUser     @relation("GRNReceivedBy", fields: [receivedByStaffId], references: [id])

  lines GoodsReceiptLine[]

  @@index([poId])
  @@map("goods_receipts")
}

enum QcResult {
  PASS
  FAIL
  PARTIAL
}

model GoodsReceiptLine {
  id          String   @id @default(uuid())
  grnId       String
  poLineId    String
  skuId       String
  expectedQty Int
  receivedQty Int
  acceptedQty Int      @default(0)
  shortQty    Int      @default(0)
  excessQty   Int      @default(0)
  damagedQty  Int      @default(0)
  rejectedQty Int      @default(0)
  qcResult    QcResult
  qcNotes     String?
  createdAt   DateTime @default(now())

  grn    GoodsReceipt      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLine PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  sku    Sku               @relation(fields: [skuId], references: [id])

  // A PO line can only be represented once per GRN (its qcResult already
  // supports a PARTIAL split of accepted/damaged/rejected within one
  // line) - certification-pass finding: without this, two lines for the
  // same poLineId in one request silently lost one update in
  // ProcurementService.applyGrnReceipt's receivedQty accumulation.
  @@unique([grnId, poLineId])
  @@index([grnId])
  @@map("goods_receipt_lines")
}

// ---------------------------------------------------------------------------
// M06: Inventory Ledger (specs/06-inventory.md, ADR-0012) - CRITICAL DOMAIN
// ---------------------------------------------------------------------------

enum InventoryTxnType {
  RECEIPT
  QC_FAIL
  RESERVATION
  RESERVATION_RELEASE
  ALLOCATION
  SALE
  CANCELLATION
  RETURN_RECEIVED
  RETURN_QC_PASS
  RETURN_QC_FAIL
  // M19 (specs/18-returns.md, INV-006): a WRITE_OFF or RETURN_TO_SUPPLIER
  // disposition - the item leaves tracked inventory entirely (destroyed,
  // or shipped back to the supplier), so it must never reappear in
  // onHand/damaged. A distinct type from RETURN_QC_FAIL (which restocks
  // as damaged/marked-down, still physically on site) is required so the
  // ledger replay in InventoryService.reconcileBalance can reconstruct the
  // correct balance from `type` alone, without needing to look up the
  // originating ReturnLine's disposition.
  RETURN_DISPOSED
  EXCHANGE_RELEASE
  EXCHANGE_RESERVE
  RTO
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

// Append-only ledger - the source of truth. Never mutated after insert.
model InventoryTransaction {
  id                String           @id @default(uuid())
  skuId             String
  locationId        String
  type              InventoryTxnType
  quantity          Int // always positive; `type` determines directional effect
  referenceType     String? // e.g. "GRN", "PO", "MANUAL", "TRANSFER", "RESERVATION"
  referenceId       String?
  reason            String?
  idempotencyKey    String?          @unique
  actorType         AuditActorType   @default(SYSTEM)
  actorStaffId      String?
  coApproverStaffId String?
  createdAt         DateTime         @default(now())

  sku             Sku        @relation(fields: [skuId], references: [id])
  location        Location   @relation(fields: [locationId], references: [id])
  actorStaff      StaffUser? @relation("InventoryAdjustmentActor", fields: [actorStaffId], references: [id], onDelete: Restrict)
  coApproverStaff StaffUser? @relation("InventoryAdjustmentCoApprover", fields: [coApproverStaffId], references: [id], onDelete: Restrict)

  @@index([skuId, locationId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

// Derived, transactionally-maintained cache. Must always equal the replay
// of InventoryTransaction for (skuId, locationId) - see reconciliation test.
model InventoryBalance {
  skuId         String
  locationId    String
  onHand        Int      @default(0)
  reserved      Int      @default(0)
  damaged       Int      @default(0)
  returnPending Int      @default(0)
  inTransit     Int      @default(0)
  updatedAt     DateTime @updatedAt

  sku      Sku      @relation(fields: [skuId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([skuId, locationId])
  @@map("inventory_balances")
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

model InventoryReservation {
  id             String            @id @default(uuid())
  skuId          String
  locationId     String
  quantity       Int
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime
  referenceType  String? // e.g. "CHECKOUT_SESSION", "COD_ORDER" (future)
  referenceId    String?
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sku Sku @relation(fields: [skuId], references: [id])

  @@index([skuId, locationId, status])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

enum TransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model InventoryTransfer {
  id             String         @id @default(uuid())
  skuId          String
  fromLocationId String
  toLocationId   String
  quantity       Int
  status         TransferStatus @default(IN_TRANSIT)
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  sku          Sku      @relation(fields: [skuId], references: [id])
  fromLocation Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("TransferTo", fields: [toLocationId], references: [id])

  @@map("inventory_transfers")
}

// ---------------------------------------------------------------------------
// M07: Catalog / Merchandising / Pricing (specs/07-catalog-merchandising.md)
// ---------------------------------------------------------------------------

model Price {
  id            String    @id @default(uuid())
  styleId       String
  colourId      String? // null = applies to all colours of the style
  mrp           Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR")
  isMarkdown    Boolean   @default(false)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  // Certification-pass finding: pricing history is financially/
  // analytically relevant (feeds specs/27-analytics-reporting.md) and
  // must not silently vanish - or silently change meaning - if a
  // Style/Colour row is ever deleted. Explicitly Restrict rather than
  // Cascade (loses history) or Prisma's implicit default for a
  // nullable FK, SetNull (would turn a colour-specific price into what
  // looks like a style-wide price the moment its colour is deleted -
  // worse than either alternative).
  style  Style   @relation(fields: [styleId], references: [id], onDelete: Restrict)
  colour Colour? @relation(fields: [colourId], references: [id], onDelete: Restrict)

  @@index([styleId, effectiveFrom, effectiveTo])
  @@map("prices")
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  styles CollectionStyle[]

  @@map("collections")
}

model CollectionStyle {
  collectionId String
  styleId      String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  style      Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([collectionId, styleId])
  @@map("collection_styles")
}

enum BadgeType {
  NEW_ARRIVAL
  BESTSELLER
  SALE
  MARKDOWN
}

enum BadgeSource {
  RULE
  MANUAL
}

model MerchandiseBadge {
  id        String      @id @default(uuid())
  styleId   String
  badgeType BadgeType
  source    BadgeSource @default(RULE)
  startsAt  DateTime    @default(now())
  endsAt    DateTime?
  createdAt DateTime    @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
  @@map("merchandise_badges")
}

// ---------------------------------------------------------------------------
// M08: India Tax / GST / Invoicing (specs/32-india-tax-invoicing.md)
//
// Everything below is an ENGINEERING-CONFIGURABLE architecture per the
// Product Owner's Phase 2 "START BUILD" instruction: no GST rate, HSN
// classification, or registration is hard-coded. TAX-001-005
// (blueprint/DECISION_REGISTER.md) gate the real production values that
// get entered as rows below - they do not gate this schema. The tax
// engine must fail safely (reject, not guess) whenever a required row is
// absent, per that instruction.
//
// Invoice/InvoiceLine/CreditNote/CreditNoteLine are immutable historical
// SNAPSHOTS, not live joins - every display field a document needs is
// copied onto the row at issue time so a later change to product,
// customer, or tax-reference data can never silently rewrite a document
// already issued (spec 32 "Historical orders must retain the actual tax
// calculation used at transaction time").
//
// Invoice.orderId is a plain (non-FK) reference deliberately: the Order
// model does not exist until M15. The FK relation is added when M15
// creates Order, without changing this table's shape.
// ---------------------------------------------------------------------------

enum GstRegistrationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

model LegalEntity {
  id                     String   @id @default(uuid())
  legalName              String
  pan                    String?
  cin                    String?
  registeredAddressLine1 String?
  registeredAddressLine2 String?
  registeredCity         String?
  registeredState        String?
  registeredPinCode      String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  gstRegistrations   GstRegistration[]
  complianceProfiles ComplianceProfile[]

  @@map("legal_entities")
}

// One legal entity MAY hold multiple GST registrations (one per State/UT
// it is established in, per TAX-001) - modelled as a real one-to-many
// from day one rather than a single-registration assumption baked into
// the shape, even though only one row is expected to exist at launch.
model GstRegistration {
  id            String                @id @default(uuid())
  legalEntityId String
  gstin         String                @unique
  stateCode     String // 2-digit GST State/UT code
  stateName     String
  status        GstRegistrationStatus @default(PENDING)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  locations   Location[]
  invoices    Invoice[]

  @@index([stateCode])
  @@index([legalEntityId])
  @@map("gst_registrations")
}

// Configurable applicability gate for e-invoicing (IRP reporting), kept
// deliberately separate from IRP *reporting-time* restrictions (spec 32
// "keep separate concepts for: whether e-invoicing applies; and
// applicable IRP reporting time restrictions" - the latter is enforced in
// the adapter/service layer against einvoiceApplicableFrom, not modelled
// as a second table here).
model ComplianceProfile {
  id                     String    @id @default(uuid())
  legalEntityId          String
  aatoThresholdCrores    Decimal?  @db.Decimal(10, 2) // annual aggregate turnover profile, configured, never inferred
  einvoiceApplicable     Boolean   @default(false)
  einvoiceApplicableFrom DateTime?
  exemptionNotes         String?
  effectiveFrom          DateTime  @default(now())
  effectiveTo            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  @@index([legalEntityId, effectiveFrom])
  @@map("compliance_profiles")
}

enum TaxVerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
}

// Effective-dated HSN/rate/cess reference data. Resolution picks the
// row whose [effectiveFrom, effectiveTo) window contains the query date,
// mirroring CatalogService.getActivePrice's deterministic resolution
// (specificity/recency ordering) rather than assuming at most one row
// can ever match.
model TaxRate {
  id                 String                @id @default(uuid())
  hsnCode            String
  description        String?
  gstRatePercent     Decimal               @db.Decimal(5, 2)
  cessPercent        Decimal?              @db.Decimal(5, 2)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  sourceReference    String? // notification number / URL - provenance, not verification
  verificationStatus TaxVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([hsnCode, effectiveFrom])
  @@map("tax_rates")
}

enum EInvoiceStatus {
  NOT_APPLICABLE
  PENDING
  SUBMITTED
  ACKNOWLEDGED
  FAILED
}

model Invoice {
  id                String   @id @default(uuid())
  invoiceNumber     String   @unique // formatted, e.g. "INV/2026-27/000123"
  financialYear     String // e.g. "2026-27"
  sequenceNumber    Int // raw per-financial-year counter behind invoiceNumber
  gstRegistrationId String
  invoiceDate       DateTime @default(now())
  orderId           String   @unique // plain reference; FK added when M15 creates Order

  // Supplier snapshot (frozen from LegalEntity/GstRegistration at issue time)
  supplierLegalName String
  supplierAddress   Json
  supplierGstin     String

  // Recipient snapshot (frozen; B2C recipient GSTIN is normally absent)
  recipientName      String
  recipientGstin     String?
  billingAddress     Json
  deliveryAddress    Json
  placeOfSupplyState String
  placeOfSupplyCode  String
  isIntraState       Boolean
  reverseCharge      Boolean @default(false)

  // Commercial totals (sum of InvoiceLine rows, frozen)
  totalTaxableValue Decimal @db.Decimal(14, 2)
  totalDiscount     Decimal @default(0) @db.Decimal(14, 2)
  totalCgst         Decimal @default(0) @db.Decimal(14, 2)
  totalSgst         Decimal @default(0) @db.Decimal(14, 2)
  totalIgst         Decimal @default(0) @db.Decimal(14, 2)
  totalCess         Decimal @default(0) @db.Decimal(14, 2)
  totalInvoiceValue Decimal @db.Decimal(14, 2)

  templateVersion Int @default(1)

  // E-invoice / IRP readiness (adapter boundary - see einvoice-adapter.ts).
  // No real IRP integration is authorized; these fields exist so one can
  // be plugged in later without a schema change.
  irpStatus      EInvoiceStatus @default(NOT_APPLICABLE)
  irn            String?
  irnAckNumber   String?
  irnAckDate     DateTime?
  irnQrPayload   String?
  irpSubmittedAt DateTime?
  irpErrorDetail String?
  irpRetryCount  Int            @default(0)

  createdAt DateTime @default(now())

  gstRegistration GstRegistration @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  lines           InvoiceLine[]
  creditNotes     CreditNote[]

  @@index([financialYear, sequenceNumber])
  @@index([gstRegistrationId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  skuId       String
  // M18 (specs/17-cancellation.md): nullable, additive correlation back
  // to the OrderLine this invoice line was generated from - lets
  // cancellation find the exact InvoiceLine to credit without a fragile
  // skuId/quantity heuristic (an order can legitimately contain two
  // lines for the same SKU). Populated going forward by
  // OrderService.issueOrderInvoice; null on invoices issued before this
  // migration - cancellation degrades gracefully (skips the automatic
  // credit-note step) for those, never guesses a match.
  orderLineId String? @unique

  // Frozen display snapshot - never re-derived from current product data
  skuCodeSnapshot     String
  descriptionSnapshot String
  colourSnapshot      String?
  sizeSnapshot        String?
  hsnCodeSnapshot     String

  quantity       Int
  unitOfMeasure  String  @default("PCS")
  grossValue     Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableValue   Decimal @db.Decimal(12, 2)
  gstRatePercent Decimal @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal @default(0) @db.Decimal(12, 2)
  cessAmount     Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Restrict)

  creditNoteLines CreditNoteLine[]

  @@index([invoiceId])
  @@map("invoice_lines")
}

model CreditNote {
  id                String   @id @default(uuid())
  creditNoteNumber  String   @unique
  financialYear     String
  sequenceNumber    Int
  originalInvoiceId String
  issueDate         DateTime @default(now())
  reason            String
  referenceNote     String? // plain reference to the cancellation/return/refund record that triggered this (those milestones are not built yet)

  totalTaxableValueReduction Decimal @db.Decimal(14, 2)
  totalCgstReduction         Decimal @default(0) @db.Decimal(14, 2)
  totalSgstReduction         Decimal @default(0) @db.Decimal(14, 2)
  totalIgstReduction         Decimal @default(0) @db.Decimal(14, 2)
  totalCessReduction         Decimal @default(0) @db.Decimal(14, 2)
  totalValueReduction        Decimal @db.Decimal(14, 2)

  templateVersion Int      @default(1)
  createdAt       DateTime @default(now())

  originalInvoice Invoice          @relation(fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  lines           CreditNoteLine[]
  refund          Refund?

  @@index([financialYear, sequenceNumber])
  @@index([originalInvoiceId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String @id @default(uuid())
  creditNoteId  String
  invoiceLineId String

  descriptionSnapshot String
  hsnCodeSnapshot     String
  quantity            Int

  taxableValueReduction Decimal @db.Decimal(12, 2)
  gstRatePercent        Decimal @db.Decimal(5, 2)
  cgstReduction         Decimal @default(0) @db.Decimal(12, 2)
  sgstReduction         Decimal @default(0) @db.Decimal(12, 2)
  igstReduction         Decimal @default(0) @db.Decimal(12, 2)
  cessReduction         Decimal @default(0) @db.Decimal(12, 2)
  lineTotalReduction    Decimal @db.Decimal(12, 2)

  creditNote  CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)

  @@index([creditNoteId])
  @@index([invoiceLineId])
  @@map("credit_note_lines")
}

// ---------------------------------------------------------------------------
// M09: Watch & Shop (specs/35-watch-and-shop.md)
//
// A discovery surface over the SAME commerce data PDP/Cart use - never a
// second source of product/price/inventory truth. ShoppableMediaTag only
// references a Style(+Colour+Size); it carries no price/availability copy
// of its own for the storefront to resolve at read time via the real
// Catalog/Inventory services.
// ---------------------------------------------------------------------------

enum ShoppableMediaState {
  DRAFT
  PENDING_MODERATION
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  REJECTED
}

model ShoppableMedia {
  id                    String              @id @default(uuid())
  title                 String
  mediaUrl              String
  thumbnailUrl          String?
  creatorAttribution    String?
  campaignRef           String?
  state                 ShoppableMediaState @default(DRAFT)
  scheduledPublishAt    DateTime?
  publishedAt           DateTime?
  merchandisingPosition Int                 @default(0)
  moderatedByStaffId    String?
  moderationNote        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Explicitly Restrict, not Prisma's implicit SetNull default - same
  // audit-attribution rationale as AuditLog.actorStaff.
  moderatedBy StaffUser? @relation("ShoppableMediaModeratedBy", fields: [moderatedByStaffId], references: [id], onDelete: Restrict)

  tags   ShoppableMediaTag[]
  events ShoppableMediaEvent[]

  @@index([state, merchandisingPosition])
  @@index([state, scheduledPublishAt])
  @@map("shoppable_media")
}

model ShoppableMediaTag {
  id               String  @id @default(uuid())
  shoppableMediaId String
  styleId          String
  colourId         String?
  sizeId           String?
  sortOrder        Int     @default(0)

  shoppableMedia ShoppableMedia @relation(fields: [shoppableMediaId], references: [id], onDelete: Cascade)
  style          Style          @relation(fields: [styleId], references: [id], onDelete: Restrict)
  colour         Colour?        @relation(fields: [colourId], references: [id], onDelete: Restrict)
  size           Size?          @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([shoppableMediaId, styleId, colourId])
  @@index([shoppableMediaId])
  @@map("shoppable_media_tags")
}

// Analytics event *capture* only (spec 35) - no dashboards/reporting here.
model ShoppableMediaEvent {
  id               String         @id @default(uuid())
  shoppableMediaId String
  eventType        String // VIEW | TAG_TAP | ADD_TO_BAG
  actorType        AuditActorType @default(CUSTOMER)
  customerId       String?
  sessionRef       String?
  createdAt        DateTime       @default(now())

  shoppableMedia ShoppableMedia @relation(fields: [shoppableMediaId], references: [id], onDelete: Cascade)

  @@index([shoppableMediaId, eventType])
  @@map("shoppable_media_events")
}

// ---------------------------------------------------------------------------
// M11: PDP (specs/10-pdp.md) - reviews/ratings (PDP-001), PIN-code
// serviceability static-list fallback (IND-002), cross-sell manual
// overrides (PDP-002 - rule-based same-category matching is computed at
// query time in the service layer, never stored).
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

// Auto-published on submission (engineering default - PDP-001 doesn't
// specify a pre-moderation queue); staff can hide abusive/spam content
// after the fact via content:moderate. Average rating/count shown on PDP
// are always computed live from PUBLISHED rows here - never a fabricated
// or cached count (consistent with the "no fake engagement numbers"
// discipline applied throughout Phase 2 - see Watch & Shop).
model Review {
  id                 String       @id @default(uuid())
  styleId            String
  customerId         String
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PUBLISHED)
  moderatedByStaffId String?
  moderatedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  style       Style      @relation(fields: [styleId], references: [id], onDelete: Cascade)
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  moderatedBy StaffUser? @relation("ReviewModeratedBy", fields: [moderatedByStaffId], references: [id], onDelete: Restrict)

  // One review per customer per style - prevents review-count inflation.
  @@unique([styleId, customerId])
  @@index([styleId, status])
  @@map("reviews")
}

// IND-002 engineering-default fallback data source ("static/periodically-
// updated list") - a real carrier-API check (SHIP-002) is M16's own scope
// and not built here; this table is what PDP and checkout (M13) both
// query today, structured so a real carrier adapter can be swapped in
// later without changing the read-path contract.
model ServiceablePincode {
  pincode          String   @id
  city             String
  state            String
  isServiceable    Boolean  @default(true)
  codAvailable     Boolean  @default(true)
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  updatedAt        DateTime @updatedAt

  @@map("serviceable_pincodes")
}

// PDP-002: only the manual-override half of cross-sell is persisted - the
// rule-based half (same/complementary category) is computed live in
// CrossSellService, never stored, so it can never drift from the current
// catalog. An override always outranks a rule-based pick for the same
// styleId.
model CrossSellOverride {
  id               String   @id @default(uuid())
  styleId          String
  relatedStyleId   String
  sortOrder        Int      @default(0)
  createdByStaffId String
  createdAt        DateTime @default(now())

  style          Style     @relation("CrossSellFrom", fields: [styleId], references: [id], onDelete: Cascade)
  relatedStyle   Style     @relation("CrossSellTo", fields: [relatedStyleId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)

  @@unique([styleId, relatedStyleId])
  @@map("cross_sell_overrides")
}

// ---------------------------------------------------------------------------
// M12: Wishlist / Cart (specs/11-wishlist-cart.md, CART-001/002/003, INV-002)
// ---------------------------------------------------------------------------

// One cart per identity: either a logged-in Customer (customerId set,
// guestSessionId null) or a guest device/session (guestSessionId set,
// customerId null) - never both, enforced by a hand-written CHECK
// constraint (see migration) mirroring the M08/M11 defense-in-depth
// pattern. A guest cart is considered expired once lastActivityAt is
// older than the configurable CART_GUEST_TTL_DAYS window (CART-001);
// expiry is evaluated at read time in CartService, not swept by a cron.
model Cart {
  id             String   @id @default(uuid())
  customerId     String?  @unique
  guestSessionId String?  @unique
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

// Adding to cart never reserves inventory (INV-002) - this table has no
// relationship to InventoryReservation at all. priceAtAdd is a snapshot
// used only to detect and surface a price change to the customer
// (spec requirement); it is never charged - the checkout flow (M13) will
// always re-price from the live Price table.
model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  skuId      String
  quantity   Int
  priceAtAdd Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId])
  @@map("cart_items")
}

// Same identity model as Cart above (one per Customer or one per guest
// session, never both).
model Wishlist {
  id             String   @id @default(uuid())
  customerId     String?  @unique
  guestSessionId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  skuId      String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, skuId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// M13: Checkout (specs/12-checkout.md, CHK-001/002/003/004, INV-002)
// ---------------------------------------------------------------------------

// Configurable shipping-cost rule (CHK-003). Engineering-default shape:
// a single active row, either a flat rate or "free above a threshold"
// (the two rule types actually wired up - weight/value-based shipping is
// deferred, since no product-weight data model exists yet). Kept as a
// table (not an env var) so ops can change it without a redeploy.
enum ShippingRuleType {
  FLAT
  FREE_ABOVE_THRESHOLD
}

model ShippingRule {
  id                 String           @id @default(uuid())
  type               ShippingRuleType
  flatAmount         Decimal?         @db.Decimal(10, 2)
  freeAboveThreshold Decimal?         @db.Decimal(10, 2)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("shipping_rules")
}

// This is the "order creation trigger" artifact checkout produces - NOT
// the formal Order/order-management model. That is M15's own milestone
// to create (see the pre-existing comment on Invoice.orderId below and
// InvoiceService's docblock: "M15 ... will call issueInvoice() ... once
// the Order model exists"). A CheckoutSession's id is a stable,
// order-shaped identifier other modules can already reference by plain
// string (the same pattern Invoice.orderId already uses) without a real
// FK, so M15 can adopt/promote it later without a breaking change here.
enum CheckoutSessionStatus {
  STARTED
  RESERVED
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  // Independent-review finding #3: a genuine Razorpay capture arrived
  // after this session's own attempt had already reached a terminal
  // non-success state (EXPIRED/FAILED) - most plausibly because its
  // inventory reservation was already released by the payment-expiry
  // or reservation-TTL sweep. The payment is real and is recorded as
  // CAPTURED regardless (see Payment.status) - inventory is never
  // auto-reallocated here (that would risk oversell/a fake allocation
  // that ships nothing) and no order is created. This is a terminal
  // state requiring manual operator reconciliation (manually fulfil
  // once stock is confirmed available, or a refund - the refund
  // workflow itself is specs/19-refunds.md, M20, out of this
  // milestone's scope).
  CAPTURE_RECONCILIATION_REQUIRED
}

enum CheckoutPaymentMethod {
  PREPAID
  COD
}

model CheckoutSession {
  id                   String                @id @default(uuid())
  customerId           String?
  guestSessionId       String?
  contactName          String
  contactMobile        String
  contactEmail         String?
  billingAddress       Json
  shippingAddress      Json
  shippingStateCode    String
  shippingMethodCode   String                @default("STANDARD")
  shippingCost         Decimal               @db.Decimal(10, 2)
  subtotal             Decimal               @db.Decimal(10, 2) // tax-inclusive sum of lines
  taxAmount            Decimal               @db.Decimal(10, 2) // informational - already included within subtotal
  grandTotal           Decimal               @db.Decimal(10, 2)
  currency             String                @default("INR")
  paymentMethod        CheckoutPaymentMethod
  status               CheckoutSessionStatus @default(STARTED)
  idempotencyKey       String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  confirmedAt          DateTime?
  // Set only when status = CAPTURE_RECONCILIATION_REQUIRED (independent-
  // review finding #3) - the operator-facing explanation of why a
  // genuinely-captured payment did not result in an order.
  reconciliationReason String?

  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    CheckoutSessionLine[]
  payments Payment[]
  order    Order?

  @@index([status])
  @@map("checkout_sessions")
}

// Frozen line-item snapshot, the same discipline as InvoiceLine - never
// re-derived from current product/price data after creation.
model CheckoutSessionLine {
  id                   String  @id @default(uuid())
  checkoutSessionId    String
  skuId                String
  locationId           String
  quantity             Int
  unitPriceInclusive   Decimal @db.Decimal(10, 2)
  taxableValueSnapshot Decimal @db.Decimal(10, 2)
  gstRatePercent       Decimal @db.Decimal(5, 2)
  taxAmountSnapshot    Decimal @db.Decimal(10, 2)
  lineTotalInclusive   Decimal @db.Decimal(10, 2)
  reservationId        String? // plain reference to InventoryReservation.id

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  sku             Sku             @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("checkout_session_lines")
}

// Payment (M13 lays the abstraction + a fully-working COD path; the real
// Razorpay integration - authorize/capture/refund/webhook - is M14's own
// scope, ADR-0011). Payment state is deliberately its own state machine,
// never conflated with CheckoutSessionStatus (specs/13-payment.md).
enum PaymentProviderType {
  RAZORPAY
  COD
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  CONFIRMED // COD's own terminal success state - no capture step
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

// M14: one-to-many with CheckoutSession (not unique) - a failed/expired
// payment attempt can be retried from the same session without creating
// a new session or losing the reservation (PAY-005). CheckoutService's
// own view always resolves "the current attempt" as the most recent row
// for a session, ordered by createdAt.
model Payment {
  id                  String              @id @default(uuid())
  checkoutSessionId   String
  provider            PaymentProviderType
  status              PaymentStatus       @default(INITIATED)
  amount              Decimal             @db.Decimal(10, 2)
  providerReferenceId String?
  idempotencyKey      String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  events          PaymentEvent[]
  refunds         Refund[]

  @@index([checkoutSessionId, createdAt])
  @@map("payments")
}

// Webhook event log (PAY-003): every inbound provider webhook is
// recorded here BEFORE any state change is applied, keyed uniquely per
// (provider, providerEventId) so a duplicate delivery of the same event
// is detected and turned into a safe no-op rather than a second capture/
// refund. This is the auditable record financial-integrity review
// depends on - never pruned, never mutated after insert (except its own
// `status`/`processedAt`/`processingError` processing-lifecycle fields
// below, which record what happened to THIS event, not the payload).
//
// Final certification repair pass, Blocker 2: the unique-constraint
// dedup above used to mean "already recorded = skip" - but the row was
// persisted BEFORE the business transition (applyOutcome) ran, so a
// transient failure between recording and completing that transition
// left a "RECEIVED but never actually applied" row that a Razorpay
// retry of the SAME providerEventId could never re-trigger (the retry
// hit the unique constraint and was treated as a duplicate no-op,
// silently losing the event). `status` makes "recorded" and
// "successfully processed" two distinct, durable facts: only PROCESSED
// short-circuits a retry as a safe no-op; RECEIVED or FAILED means
// processing is retried using this same row (never a second insert,
// never data loss, never re-running an already-PROCESSED event).
enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model PaymentEvent {
  id              String              @id @default(uuid())
  provider        PaymentProviderType
  providerEventId String
  eventType       String
  paymentId       String?
  // M21: set instead of paymentId when this event correlates to an
  // Exchange's own price-difference payment (a captured payment that was
  // never a checkout-session Payment row) - ExchangeService owns its own
  // dedup/processing against this event, entirely separate from
  // PaymentService's own applyOutcome/applyCaptureOutcome transactions
  // (M14-certified code, deliberately left untouched by M21 - see
  // PaymentService.handleRazorpayWebhook's own docblock for why this
  // dispatch is additive, not a modification to that logic).
  exchangeId      String?
  payload         Json
  receivedAt      DateTime            @default(now())
  status          PaymentEventStatus  @default(RECEIVED)
  processedAt     DateTime?
  processingError String?

  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  exchange Exchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// M15: Order Management (specs/14-order-management.md, ORD-001-006)
// ---------------------------------------------------------------------------
//
// Scope boundary (documented, not silently cut): this milestone owns the
// Order entity, its state machine, order-to-inventory allocation, partial
// cancellation, and the split-shipment DATA MODEL. It deliberately does
// NOT include a real carrier adapter/tracking webhook
// (specs/16-shipping-tracking.md), a real warehouse pick-list UI
// (specs/15-warehouse-fulfilment.md), actual refund EXECUTION via Razorpay
// (specs/19-refunds.md - PaymentProvider.refund() exists and is correct,
// same "built but not yet wired to a route" honesty as M14's own refund
// scope note), or return/QC processing (specs/18-returns.md) - all
// explicitly later milestones per specs/14's own "Feeds:" list. Where an
// acceptance-criteria flow (e.g. RTO) needs one of those to be fully
// automatic, this milestone provides the correct STATE TRANSITION and
// business-rule branching (e.g. COD vs prepaid RTO closure) via an
// explicit staff-triggered action, not a simulated carrier callback.

// Coarse, queryable order-level status, derived from OrderLine statuses
// (see OrderService.computeOrderStatus) except RTO, which is always an
// explicit staff action on a SHIPPED order - never derived.
enum OrderStatus {
  CONFIRMED
  PROCESSING
  DELIVERED
  CANCELLED
  RTO
  EXCEPTION
}

// Line-level status carries the real granularity (partial cancellation,
// split shipment) - ORD-001's "line-item-level state" requirement.
// M16 (specs/15-warehouse-fulfilment.md) inserts PICKED between ALLOCATED
// and PACKED - a line MUST be fully picked (its PickTask reaches PICKED)
// before it is eligible for OrderService.assignLinesToFulfilment (the
// "only legitimately picked quantities may be packed" invariant).
enum OrderLineStatus {
  ALLOCATED
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  EXCEPTION
}

// M16 inserts READY_TO_SHIP between PACKED and SHIPPED - the explicit
// warehouse/shipping hand-off boundary the M16 build instruction requires
// ("create only the explicit adapter/handoff boundary required by M16").
// OrderService.markFulfilmentShipped (M15, unchanged in its own logic -
// still posts the SALE ledger transaction) now requires READY_TO_SHIP
// rather than PACKED, so a fulfilment cannot be shipped without an
// explicit staff confirmation that packing is complete and the package is
// staged for carrier pickup - real carrier integration itself remains
// M17's own, separately-authorized scope.
enum FulfilmentStatus {
  PENDING
  PACKED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum PickTaskStatus {
  PENDING
  PICKED
  SHORT_PICKED
  EXCEPTION
  CANCELLED
}

// The physical-stock-vs-system-record mismatch types a picker can report
// at pick time (specs/15-warehouse-fulfilment.md: "a pick exception MUST
// post an authorized/audited inventory adjustment and trigger the order-
// exception path"). Deliberately a closed, small set rather than a free-
// text-only reason - lets operations dashboards and NFR queries group/
// count exceptions by cause without parsing prose.
enum PickExceptionType {
  STOCK_NOT_FOUND
  INSUFFICIENT_STOCK
  DAMAGED
  WRONG_SKU_FOUND
  OTHER
}

// M16 — Warehouse & Fulfilment (specs/15-warehouse-fulfilment.md, WH-001,
// WH-002). The actionable unit of pick work: exactly one per OrderLine
// (1:1, enforced by orderLineId's unique constraint), auto-created inside
// the SAME transaction as OrderLine creation (OrderService.
// createOrderFromCheckoutSession -> WarehouseService.createPickTasksForOrder)
// - "warehouse work creation" in the M16 build instruction's flow diagram
// is therefore never a separate, forgettable manual step; it happens the
// instant a line becomes ALLOCATED, exactly like M08's invoice generation
// happens the instant an order is confirmed.
//
// Deliberately a single-call, single-terminal-transition design (PENDING
// -> one of PICKED/SHORT_PICKED/EXCEPTION/CANCELLED) rather than adding a
// separate "IN_PROGRESS/claimed-by" state: this platform's pick/pack
// actions are synchronous HTTP calls (a scanner or UI submits one outcome
// per task), not a long-running async job a worker could crash mid-way
// through leaving an unobserved intermediate state. Concurrency safety
// (two pickers racing the same task) is provided by row-locking the task
// row (SELECT ... FOR UPDATE, the same idiom InventoryService.
// lockReservation/lockBalance already use) inside one transaction, not by
// an extra status value - the same reasoning already applied to
// PaymentEventStatus's 3-state (not 4-state) design in the M14 payment
// webhook rework.
//
// allocatedQuantity is a snapshot of OrderLine.quantity at task-creation
// time (frozen-document discipline shared with CheckoutSessionLine/
// InvoiceLine): OrderLine.quantity never changes post-order in this
// platform, so today this is always equal to the live value, but snapshotting
// costs nothing and removes any future ambiguity about which quantity a
// historical pick task was actually working against.
model PickTask {
  id                String             @id @default(uuid())
  orderId           String
  orderLineId       String             @unique
  skuId             String
  locationId        String
  allocatedQuantity Int
  pickedQuantity    Int                @default(0)
  status            PickTaskStatus     @default(PENDING)
  exceptionType     PickExceptionType?
  exceptionReason   String?
  // Idempotency key for the one mutating action this resource supports
  // (recording a pick outcome) - a network-level retry/replay of the
  // exact same request is a safe no-op (same pattern as Payment.
  // idempotencyKey / InventoryReservation.idempotencyKey), while a
  // different key against an already-terminal task is a genuine conflict
  // (either a second, distinct picker, or a client bug), not a replay.
  idempotencyKey    String?
  pickedByStaffId   String?
  pickedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine     OrderLine  @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  sku           Sku        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location      Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  pickedByStaff StaffUser? @relation("PickTaskPickedBy", fields: [pickedByStaffId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([locationId, status])
  @@map("pick_tasks")
}

// The formal Order (as distinct from CheckoutSession, the "order creation
// trigger" artifact - see the comment on CheckoutSession). Created
// in-process, never via a public "create order" endpoint, the moment a
// CheckoutSession's payment genuinely succeeds (COD acceptance or
// Razorpay capture webhook) - OrderService.createOrderFromCheckoutSession,
// called from CheckoutService and PaymentService respectively, the same
// "M15 calls issueInvoice() in-process... once the Order model exists"
// pattern the M08 InvoiceService docblock already anticipated.
model Order {
  id                   String                @id @default(uuid())
  orderNumber          String                @unique
  checkoutSessionId    String                @unique
  customerId           String?
  guestSessionId       String?
  contactName          String
  contactMobile        String
  contactEmail         String?
  billingAddress       Json
  shippingAddress      Json
  shippingCost         Decimal               @db.Decimal(10, 2)
  subtotal             Decimal               @db.Decimal(10, 2)
  taxAmount            Decimal               @db.Decimal(10, 2)
  grandTotal           Decimal               @db.Decimal(10, 2)
  currency             String                @default("INR")
  paymentMethod        CheckoutPaymentMethod
  status               OrderStatus           @default(CONFIRMED)
  // Set true when a cancellation/RTO on a PREPAID order requires a
  // refund that this milestone deliberately does not execute (M19's own
  // scope) - an honest marker for Finance/CS to action, never silently
  // dropped.
  refundRequired       Boolean               @default(false)
  invoiceId            String?               @unique
  // Durable invoice-generation recovery state (independent-review
  // finding #2, binding): "an invoice document is generated at order
  // confirmation" MUST hold even after a transient failure, without
  // ever risking the legitimately-paid order itself. This state lives
  // in the database, not in memory, so recovery survives a process
  // restart - a fresh process just queries `invoiceId IS NULL AND
  // invoiceStatus IN (PENDING, FAILED)` and retries, no in-memory
  // queue/timer required. See OrderService.reconcilePendingInvoices().
  invoiceStatus        OrderInvoiceStatus    @default(PENDING)
  invoiceFailureReason String?
  invoiceAttempts      Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  checkoutSession CheckoutSession   @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  lines           OrderLine[]
  fulfilments     OrderFulfilment[]
  pickTasks       PickTask[]
  shipments       Shipment[]
  returns         Return[]
  refunds         Refund[]
  exchanges       Exchange[]

  @@index([customerId])
  @@index([guestSessionId])
  @@index([invoiceStatus, invoiceId])
  @@map("orders")
}

enum OrderInvoiceStatus {
  PENDING
  ISSUED
  FAILED
}

// Frozen line-item snapshot (same discipline as CheckoutSessionLine/
// InvoiceLine - never re-derived from current product/price data).
// reservationId is the data-integrity traceability link
// (acceptance/m15-order-management.md "Data integrity") from this line
// back to the exact InventoryReservation it converted from at checkout.
model OrderLine {
  id                         String          @id @default(uuid())
  orderId                    String
  skuId                      String
  locationId                 String
  quantity                   Int
  unitPriceInclusive         Decimal         @db.Decimal(10, 2)
  taxableValueSnapshot       Decimal         @db.Decimal(10, 2)
  gstRatePercent             Decimal         @db.Decimal(5, 2)
  taxAmountSnapshot          Decimal         @db.Decimal(10, 2)
  lineTotalInclusive         Decimal         @db.Decimal(10, 2)
  reservationId              String?
  fulfilmentId               String?
  status                     OrderLineStatus @default(ALLOCATED)
  cancelledAt                DateTime?
  // M18 (specs/17-cancellation.md, approved 2026-09-22): "Cancellation
  // reason capture is optional (recommended, not mandatory)" - nullable
  // even when status = CANCELLED. The DB check constraint
  // order_lines_cancelled_fields_check (relaxed in migration
  // 20260925090000) enforces only that cancelledAt is set iff CANCELLED
  // and that cancelledReason is null on any non-cancelled line.
  cancelledReason            String?
  exceptionReason            String?
  // M18 (specs/17-cancellation.md): durable idempotency key for the one
  // mutating action this field guards (cancelling this line) - same
  // discipline as Payment/Shipment/PickTask.idempotencyKey. Set only on
  // a SUCCESSFUL cancellation commit, never on a rejected attempt, so a
  // reused key always resolves to a genuinely-cancelled line. Global
  // uniqueness (not scoped per-line) is deliberate: it is what lets a
  // reused key against a DIFFERENT order line be detected and rejected
  // as a genuine misuse rather than a legitimate retry.
  cancellationIdempotencyKey String?         @unique

  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        Sku              @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location   Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  fulfilment OrderFulfilment? @relation(fields: [fulfilmentId], references: [id], onDelete: SetNull)
  pickTask   PickTask?
  returnLine ReturnLine?
  refund     Refund?
  exchange   Exchange?

  @@index([orderId])
  @@map("order_lines")
}

// A single shipment/package (ORD-001: "one order MAY have multiple
// fulfilments/packages"). Each OrderLine belongs to at most one
// Fulfilment at a time - a line is assigned to a Fulfilment once it has
// been fully picked (M16 gate: OrderService.assignLinesToFulfilment now
// requires OrderLineStatus.PICKED, the engineering-level analogue of
// "generate a pick list" the M15 scope-boundary note anticipated) and the
// two progress through PACKED/READY_TO_SHIP/SHIPPED/DELIVERED together.
model OrderFulfilment {
  id          String           @id @default(uuid())
  orderId     String
  status      FulfilmentStatus @default(PENDING)
  carrierName String?
  trackingRef String?
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines    OrderLine[]
  shipment Shipment?

  @@index([orderId])
  @@map("order_fulfilments")
}

// ---------------------------------------------------------------------------
// M17: Shipping / Tracking (specs/16-shipping-tracking.md, SHIP-001-004,
// ADR-0020)
// ---------------------------------------------------------------------------
//
// Owns the lifecycle FROM the M16 READY_TO_SHIP hand-off onward: carrier
// booking, tracking-status progression, delivery-attempt counting, and RTO
// progression. Deliberately does NOT duplicate what OrderFulfilment
// already owns (carrierName/trackingRef/shippedAt/deliveredAt stay there -
// they are the authoritative business-lifecycle fields SALE-posting and
// order-status recompute already depend on); Shipment adds only what M17
// needs beyond that: provider identity, the provider's own shipment/AWB
// references, a platform-normalized tracking status finer-grained than
// FulfilmentStatus, delivery-attempt/RTO counters, and idempotent carrier-
// booking intent. One Shipment per OrderFulfilment (1:1, `fulfilmentId`
// unique) - split shipments are OrderFulfilment's existing data model
// (M15/M16), so "one order -> many independently-tracked shipments" falls
// out of "one order -> many OrderFulfilments -> one Shipment each" for
// free, no new one-to-many modelling needed here.
enum ShipmentTrackingStatus {
  // Local durable intent, recorded BEFORE the carrier is ever called -
  // the write-ahead half of the create-shipment failure-window design
  // (SHIP §7): a crash between this row committing and the carrier call
  // returning is recoverable by retry, never a lost or duplicated booking.
  CREATED
  BOOKED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
  RTO_INITIATED
  RTO_DELIVERED
}

enum ShipmentEventSource {
  WEBHOOK
  POLL
  MANUAL
}

// Mirrors PaymentEventStatus exactly (ADR-0011/PaymentService's durable
// RECEIVED -> PROCESSED|FAILED pattern) - the "durable lesson already
// learned" for webhook processing this milestone reuses rather than
// reinventing: a webhook event is durably recorded BEFORE it is applied,
// and is marked PROCESSED only once the resulting tracking transition has
// actually committed, so a transient failure leaves it retryable
// (redelivery resumes against the SAME row) rather than silently lost.
enum ShipmentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Shipment {
  id                  String                 @id @default(uuid())
  fulfilmentId        String                 @unique
  orderId             String
  provider            String
  providerShipmentRef String?
  trackingRef         String?
  status              ShipmentTrackingStatus @default(CREATED)
  deliveryAttempts    Int                    @default(0)
  // Snapshot of the configured SHIPPING_MAX_REDELIVERY_ATTEMPTS at
  // creation time (SHIP-004: "configurable, engineering default 2") - a
  // later config change must never retroactively alter the attempt
  // budget of a shipment already in flight.
  maxDeliveryAttempts Int
  // Carrier-call idempotency key (SHIP §7) - the local Shipment.id itself
  // is already unique per fulfilment, but this column lets a retried
  // create-shipment HTTP request (same client idempotency key) resolve to
  // the SAME shipment row rather than a second one, mirroring Payment.
  // idempotencyKey / InventoryReservation.idempotencyKey / PickTask.
  // idempotencyKey.
  idempotencyKey      String                 @unique
  createdByStaffId    String?
  bookedAt            DateTime?
  deliveredAt         DateTime?
  rtoInitiatedAt      DateTime?
  rtoDeliveredAt      DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  fulfilment     OrderFulfilment         @relation(fields: [fulfilmentId], references: [id], onDelete: Restrict)
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdByStaff StaffUser?              @relation("ShipmentCreatedBy", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  events         ShipmentTrackingEvent[]

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

// Append-only. Serves two roles at once (deliberately, to avoid a second
// dedup-table proliferation alongside PaymentEvent): the durable webhook-
// processing-state record (source=WEBHOOK rows use it exactly like
// PaymentEvent) AND the customer/audit-visible tracking history ledger
// (source=POLL/MANUAL rows have no provider event to dedup on and simply
// append). `providerEventId` is nullable specifically so POLL/MANUAL rows
// - which have no carrier event id - never collide with each other or
// with genuine webhook deliveries under the unique constraint below
// (Postgres treats each NULL as distinct).
model ShipmentTrackingEvent {
  id               String                  @id @default(uuid())
  // Nullable (mirrors PaymentEvent.paymentId): a webhook can arrive for a
  // providerShipmentRef this platform does not (yet, or ever) recognize -
  // the event is still durably recorded/deduped, never dropped, even
  // though it cannot yet be correlated to a Shipment row.
  shipmentId       String?
  provider         String
  providerEventId  String?
  source           ShipmentEventSource
  rawStatus        String?
  normalizedStatus ShipmentTrackingStatus?
  payload          Json
  status           ShipmentEventStatus     @default(RECEIVED)
  occurredAt       DateTime
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  processingError  String?

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([shipmentId])
  @@index([status])
  @@map("shipment_tracking_events")
}

// ---------------------------------------------------------------------------
// M19: Returns (specs/18-returns.md, RET-001-004, CAN-004's sibling record
// RET-005 in blueprint/DECISION_REGISTER.md). Deliberately NOT overloading
// OrderLineStatus with the return lifecycle (per the M19 build instruction's
// own explicit boundary) - a delivered OrderLine's status stays DELIVERED
// forever as the historical fact; the Return/ReturnLine state machine below
// tracks the post-delivery lifecycle independently, linked by orderLineId.

// RET-001: "MUST be configurable by category/product - not one global
// hard-coded policy". Resolution order (most to least specific, mirroring
// Style.hsnCode's own style-then-fallback pattern): a styleId-scoped row,
// else a categoryId-scoped row, else the platform default
// (RETURN_WINDOW_DEFAULT_DAYS env var, engineering default 7 - RET-001).
// The XOR check constraint (return_policies_scope_xor_check, added in this
// migration) requires exactly one of styleId/categoryId per row - the same
// idiom orders_identity_xor_check already established for customerId/
// guestSessionId.
model ReturnPolicy {
  id         String   @id @default(uuid())
  styleId    String?  @unique
  categoryId String?  @unique
  windowDays Int
  returnable Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  style    Style?    @relation(fields: [styleId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("return_policies")
}

enum ReturnMethod {
  PICKUP
  DROP_OFF
}

enum ReturnStatus {
  REQUESTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  QC_PASSED
  QC_FAILED
  DISPOSITIONED
  CANCELLED
}

// A first-class Return, one per initiation request, holding a subset of an
// order's DELIVERED lines (subset-of-lines granularity - the same
// deliberate boundary CAN-004 established for M18 cancellation; no
// sub-quantity return of a single multi-unit line - see RET-005).
model Return {
  id                 String         @id @default(uuid())
  returnNumber       String         @unique
  orderId            String
  status             ReturnStatus   @default(REQUESTED)
  method             ReturnMethod
  initiatedBy        AuditActorType
  initiatedByStaffId String?
  // Initiation idempotency (a retried "start a return" request - browser
  // retry, double-tap - must never create two Return rows for the same
  // logical request).
  idempotencyKey     String         @unique
  cancelledAt        DateTime?
  cancelledReason    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  initiatedStaff StaffUser?    @relation("ReturnInitiatedBy", fields: [initiatedByStaffId], references: [id], onDelete: Restrict)
  lines          ReturnLine[]
  pickup         ReturnPickup?

  @@index([orderId])
  @@map("returns")
}

enum ReturnDisposition {
  RESTOCK_SELLABLE
  RESTOCK_DAMAGED
  WRITE_OFF
  RETURN_TO_SUPPLIER
}

// One ReturnLine per returned OrderLine (unique - an OrderLine can only
// ever be part of one Return, preventing a double-return attempt at the
// schema level). reason is MANDATORY (RET-002) - unlike CAN-003's
// deliberately optional cancellation reason, never inherit that laxer
// convention here.
model ReturnLine {
  id               String             @id @default(uuid())
  returnId         String
  orderLineId      String             @unique
  skuId            String
  locationId       String
  quantity         Int
  reason           String
  disposition      ReturnDisposition?
  qcResult         QcResult?
  qcNotes          String?
  qcActorStaffId   String?
  qcAt             DateTime?
  receivedAt       DateTime?
  dispositionedAt  DateTime?
  // M19->M20 durable handoff (per the build instruction's own explicit
  // "M19 must NOT execute financial refund logic" boundary): set true only
  // once QC has passed and disposition has posted the inventory effect.
  // M20's RefundService consumes lines where this is true and no Refund
  // row yet references this ReturnLine - never the other way around.
  refundEligible   Boolean            @default(false)
  refundEligibleAt DateTime?
  createdAt        DateTime           @default(now())

  return       Return     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine    OrderLine  @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  sku          Sku        @relation(fields: [skuId], references: [id], onDelete: Restrict)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  qcActorStaff StaffUser? @relation("ReturnLineQcBy", fields: [qcActorStaffId], references: [id], onDelete: Restrict)
  refund       Refund?

  @@index([returnId])
  @@map("return_lines")
}

enum ReturnPickupStatus {
  SCHEDULED
  PICKED_UP
  FAILED
}

// Reverse logistics (RET-004): one pickup covers an entire Return (all its
// lines travel back together in one parcel) - deliberately a SEPARATE
// model from Shipment, never overwriting the original outbound AWB/
// tracking history (M19 build instruction §12). Booked via the same
// two-phase durable-intent pattern ShippingService.createShipment already
// established for forward shipments (row committed in SCHEDULED status
// BEFORE the carrier call; the carrier call is idempotent-by-id) - see
// ShippingProvider.initiateReversePickup.
model ReturnPickup {
  id                String             @id @default(uuid())
  returnId          String             @unique
  provider          String
  status            ReturnPickupStatus @default(SCHEDULED)
  providerPickupRef String?
  trackingRef       String?
  idempotencyKey    String             @unique
  scheduledAt       DateTime           @default(now())
  pickedUpAt        DateTime?
  createdByStaffId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  return         Return     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser? @relation("ReturnPickupCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)

  @@map("return_pickups")
}

// --- M20 Refunds & Store Credit (specs/19-refunds.md, specs/33-store-credit-gift-cards.md) ---

enum RefundTriggerType {
  CANCELLATION
  RETURN
}

// REF-001: which financial rail a refund settles through - derived purely
// from Order.paymentMethod (PREPAID -> the original payment method,
// COD -> store credit), never from the trigger type. A COD return and a
// PREPAID return settle differently even though both are RETURN-triggered.
enum RefundMethod {
  ORIGINAL_PAYMENT_METHOD
  STORE_CREDIT
}

// Deliberately two terminal states, no in-flight "PROCESSING" state - see
// RefundService's own docblock: the durable-intent row commits as PENDING
// BEFORE the external Razorpay call (or, for STORE_CREDIT, before the
// purely-internal ledger write) and is claimed via a conditional update
// straight to COMPLETED or FAILED, the same two-phase pattern
// ShippingService.createShipment/ReturnService's reverse-pickup booking
// already established - an ambiguous third "in progress" status would
// only invite two concurrent attempts to both think they own the retry.
enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// Only ISSUE exists in M20 - store credit is only ever created here as a
// refund/exchange consequence (REF-001, EXC-002). REDEEM (checkout-time
// spend) and REVERSE/manual ADJUST are real ledger operations spec/33
// names conceptually but no code path produces them yet (no checkout
// redemption flow exists yet - specs/33 milestone-ownership section
// explicitly scopes only the ledger FOUNDATION to M20) - left out rather
// than pre-declared unused, unlike M19's ReturnStatus.QC_PASSED/FAILED
// (which were already applied to the dev/test databases before that
// design was finalized and so were kept rather than reset).
enum StoreCreditEntryType {
  ISSUE
}

// One row per (orderId, orderLineId) that has ever qualified for a refund
// - never per-order, so a partial refund of a multi-line order/return
// naturally refunds only the qualifying lines' own original values
// (REF-003, acceptance/m20 negative scenario #2). `orderLineId` is
// @unique and is the sole idempotency anchor: a given OrderLine's
// lifecycle is CANCELLATION-refund XOR RETURN-refund, never both (a
// cancelled line can never reach DELIVERED, and only a DELIVERED line is
// return-eligible - specs/17 and specs/18's own eligibility gates already
// make these mutually exclusive, so one unique constraint safely covers
// both trigger types without a compound key).
model Refund {
  id                 String            @id @default(uuid())
  orderId            String
  orderLineId        String            @unique
  // Set only for a RETURN-triggered refund - the ReturnLine whose
  // refundEligible=true handoff (see that model's own docblock) this
  // Refund settles. Null for a CANCELLATION-triggered refund (M18's own
  // Order.refundRequired flag is that trigger's handoff instead).
  returnLineId       String?           @unique
  // The specific captured Payment this refund was issued against - set
  // only for method=ORIGINAL_PAYMENT_METHOD (a COD order's Payment is
  // never refunded through the gateway, so left null for STORE_CREDIT).
  paymentId          String?
  triggerType        RefundTriggerType
  method             RefundMethod
  // The ORIGINAL transaction value (REF-003) - never recomputed from
  // current catalog prices. Sourced from the linked CreditNote's
  // lineTotalReduction (already correctly prorated against the frozen
  // InvoiceLine amounts) when a credit note exists; falls back to
  // OrderLine.lineTotalInclusive directly only in the honest-skip case
  // where no invoice/InvoiceLine correlation exists yet (mirrors M18's
  // own credit-note honest-skip precedent).
  amount             Decimal           @db.Decimal(10, 2)
  reason             String
  status             RefundStatus      @default(PENDING)
  providerRefundId   String?
  creditNoteId       String?           @unique
  storeCreditEntryId String?           @unique
  failureReason      String?
  // Caller-supplied idempotency key (a retried "process this refund"
  // HTTP request must never double-refund) - defense-in-depth alongside
  // the structural orderLineId uniqueness above, same two-layer
  // discipline as every other mutating action in this codebase.
  idempotencyKey     String            @unique
  initiatedByStaffId String?
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine        OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  returnLine       ReturnLine?       @relation(fields: [returnLineId], references: [id], onDelete: Restrict)
  payment          Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNote       CreditNote?       @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  storeCreditEntry StoreCreditEntry? @relation(fields: [storeCreditEntryId], references: [id], onDelete: Restrict)
  initiatedByStaff StaffUser?        @relation("RefundInitiatedBy", fields: [initiatedByStaffId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refunds")
}

// REF-002/specs/33: a separate financial/customer-balance concept from
// the loyalty-points ledger (specs/22-loyalty.md) - structurally distinct
// tables, never a shared model. Owned by the SAME identity that owns the
// underlying order (customerId XOR guestSessionId - identical XOR idiom
// to orders_identity_xor_check/returns' own guest-ownership reuse), so a
// guest COD order's refund resolves to a guest-scoped account exactly the
// way a guest's order/return itself is looked up - no new, weaker
// identity mechanism invented for store credit specifically.
model StoreCreditAccount {
  id             String   @id @default(uuid())
  customerId     String?  @unique
  guestSessionId String?  @unique
  // Denormalized cache of SUM(entries), maintained transactionally
  // alongside every StoreCreditEntry insert under a row lock (ADR-0012
  // ledger discipline - the entries are the source of truth; this column
  // is a read-optimization kept in lockstep with them, never mutated
  // independently).
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  entries  StoreCreditEntry[]

  @@map("store_credit_accounts")
}

// Store credit does NOT expire (REF-002) - deliberately no `expiresAt`
// column and no expiry job anywhere in this codebase; a balance issued
// today remains exactly as redeemable a year from now.
model StoreCreditEntry {
  id             String               @id @default(uuid())
  accountId      String
  type           StoreCreditEntryType
  amount         Decimal              @db.Decimal(10, 2)
  reason         String
  referenceType  String? // e.g. "REFUND"
  referenceId    String? // e.g. the Refund.id that issued this entry
  idempotencyKey String               @unique
  actorStaffId   String?
  createdAt      DateTime             @default(now())

  account    StoreCreditAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  refund     Refund?
  exchange   Exchange?
  actorStaff StaffUser?         @relation("StoreCreditEntryActor", fields: [actorStaffId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("store_credit_entries")
}

// --- M21 Exchanges (specs/20-exchanges.md, EXC-001-003) ---

// No PAYMENT_METHOD_UNAVAILABLE/etc. terminal-failure branching here the
// way M14's Payment has - a captured/failed outcome is expressed via
// paymentStatus below, not this status, which tracks the EXCHANGE's own
// physical/business lifecycle. REPLACEMENT_UNAVAILABLE is its own
// terminal state (EXCHANGE_REPLACEMENT_HOLD_DAYS elapsed, or the
// replacement SKU's reservation was otherwise lost, before the original
// item came back) - never silently reused as CANCELLED, since the
// customer never asked to cancel; a human must follow up.
enum ExchangeStatus {
  REQUESTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  COMPLETED
  // The original item failed QC (INV-006's own gate, applied here
  // exactly as RET-005 applies it to a Return): disposition still posts
  // (a real physical-inventory requirement), but the replacement is
  // never allocated and, if a price-difference payment was already
  // captured (the CUSTOMER_PAYS direction, collected up-front), it is
  // never auto-refunded - both require an explicit human (Finance/CS)
  // decision, the same "neither silently benefits nor silently harms
  // the customer" discipline as RET-005. See EXC-004 in
  // blueprint/DECISION_REGISTER.md.
  QC_FAILED
  REPLACEMENT_UNAVAILABLE
  CANCELLED
}

// EXC-002: derived once, at request time, from replacementValue vs
// originalLineValue - never re-derived later (a subsequent catalog price
// change must not retroactively change which rail this exchange settles
// through).
enum ExchangePaymentDirection {
  CUSTOMER_PAYS
  STORE_CREDIT
  EVEN
}

enum ExchangePaymentStatus {
  NOT_REQUIRED
  PENDING
  CAPTURED
  FAILED
}

// First-class entity (EXC-001): the original order/line, the replacement
// SKU, and any payment/credit settlement all live on ONE record - never
// reconstructed by joining a Return and an unrelated new Order. Single
// original-item <-> single-replacement-item per Exchange (no separate
// "ExchangeLine" collection the way Return/ReturnLine has one-to-many) -
// the same "no sub-quantity, one line at a time" simplification already
// documented for cancellation (CAN-004) and returns (this model's own
// orderLineId is @unique, mirroring ReturnLine's).
//
// Scope boundary (EXC-004 in blueprint/DECISION_REGISTER.md): physical
// FORWARD fulfilment (pick/pack/ship/tracking) of the replacement item is
// explicitly out of this milestone's scope - `replacementAllocatedAt`
// marks the replacement as inventory-committed (a firm allocation, no
// longer available for other orders) once QC passes and payment/credit
// settles; the warehouse's own pick/pack/ship of that allocated unit is
// a manual/follow-on process, not tracked here. This mirrors RET-005's
// own honestly-scoped boundary rather than silently pretending a full
// parallel shipment pipeline exists.
model Exchange {
  id                 String         @id @default(uuid())
  exchangeNumber     String         @unique
  orderId            String
  orderLineId        String         @unique
  originalSkuId      String
  originalLocationId String
  quantity           Int
  replacementSkuId   String
  reason             String
  status             ExchangeStatus @default(REQUESTED)
  method             ReturnMethod
  initiatedBy        AuditActorType
  initiatedByStaffId String?
  // Initiation idempotency (a retried "start an exchange" request must
  // never create two Exchange rows, or reserve the replacement twice).
  idempotencyKey     String         @unique

  // Replacement reservation (INV-002 mechanics, held for
  // EXCHANGE_REPLACEMENT_HOLD_DAYS - EXC-002/acceptance negative scenario
  // #2). `replacementAllocatedAt` is set once the reservation is
  // successfully converted to a firm allocation (QC pass + payment/credit
  // settled) - see this model's own scope-boundary comment above.
  replacementReservationId String?
  replacementAllocatedAt   DateTime?

  // Price-difference settlement (EXC-002). originalLineValue mirrors
  // REF-003's "original transaction value" (the original line's own
  // frozen lineTotalInclusive); replacementValue is the replacement
  // SKU's selling price AT REQUEST TIME (necessarily current, since the
  // replacement was never previously purchased in this order) - both
  // frozen at request time, never re-derived from a later catalog price
  // change.
  originalLineValue        Decimal                  @db.Decimal(10, 2)
  replacementValue         Decimal                  @db.Decimal(10, 2)
  priceDifference          Decimal                  @db.Decimal(10, 2)
  paymentDirection         ExchangePaymentDirection
  paymentStatus            ExchangePaymentStatus    @default(NOT_REQUIRED)
  paymentProviderOrderId   String?
  paymentProviderPaymentId String?
  storeCreditEntryId       String?                  @unique

  // Reverse logistics for the ORIGINAL item (inlined rather than a
  // separate ExchangePickup table - unlike Return, which can batch
  // multiple lines into one parcel, an Exchange is always exactly one
  // item, so a second table would add nothing). Uses the SAME
  // ShippingProvider.initiateReversePickup method M19 established.
  pickupStatus         ReturnPickupStatus?
  pickupProvider       String?
  pickupProviderRef    String?
  pickupTrackingRef    String?
  pickupIdempotencyKey String?             @unique
  scheduledAt          DateTime?
  pickedUpAt           DateTime?
  receivedAt           DateTime?

  // QC + disposition of the ORIGINAL item - reuses InventoryService's
  // postReturnReceipt/postReturnDisposition exactly as ReturnLine does
  // (same RETURN_RECEIVED/RETURN_QC_PASS/RETURN_QC_FAIL/RETURN_DISPOSED
  // ledger types, same INV-006 "never auto-restock before QC" gate).
  qcResult        QcResult?
  disposition     ReturnDisposition?
  qcNotes         String?
  qcActorStaffId  String?
  qcAt            DateTime?
  dispositionedAt DateTime?

  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine        OrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  originalSku      Sku               @relation("ExchangeOriginalSku", fields: [originalSkuId], references: [id], onDelete: Restrict)
  originalLocation Location          @relation(fields: [originalLocationId], references: [id], onDelete: Restrict)
  replacementSku   Sku               @relation("ExchangeReplacementSku", fields: [replacementSkuId], references: [id], onDelete: Restrict)
  initiatedStaff   StaffUser?        @relation("ExchangeInitiatedBy", fields: [initiatedByStaffId], references: [id], onDelete: Restrict)
  qcActorStaff     StaffUser?        @relation("ExchangeQcBy", fields: [qcActorStaffId], references: [id], onDelete: Restrict)
  storeCreditEntry StoreCreditEntry? @relation(fields: [storeCreditEntryId], references: [id], onDelete: Restrict)
  paymentEvents    PaymentEvent[]

  @@index([orderId])
  @@map("exchanges")
}
