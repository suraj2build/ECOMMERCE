# Copy to .env for local development. Never commit a real .env file
# (see .gitignore) or real credentials (see SECURITY.md).

NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://fcp_app:fcp_dev_password@localhost:5432/fcp_dev

# --- Redis (sessions, cache) ---
REDIS_URL=redis://localhost:6379

# --- Search (ADR-0006) - not exercised in Phase 1 sandbox testing ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Object storage (ADR-0007, S3-compatible / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=product-media
S3_FORCE_PATH_STYLE=true

# --- Auth ---
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
# Encrypts StaffUser.mfaSecret at rest (M31). Exactly 32 bytes, hex-encoded.
# Generate a real one for anything beyond local dev, e.g.: openssl rand -hex 32
MFA_SECRET_ENCRYPTION_KEY=c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1
# Signs guest-session credentials (CART-004). Required in production and
# must differ from JWT_ACCESS_SECRET; optional in local dev.
GUEST_SESSION_SIGNING_SECRET=dev-only-guest-session-secret-change-me
GUEST_SESSION_TTL_SECONDS=2592000
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
STAFF_SESSION_TTL_SECONDS=28800

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# --- Inventory (INV-002) ---
INVENTORY_RESERVATION_TTL_SECONDS=900

# --- Approval thresholds (PO-001, ADM-003, GRN-002/004) ---
PO_APPROVAL_THRESHOLD_INR=50000
INVENTORY_ADJUSTMENT_COAPPROVAL_THRESHOLD_UNITS=50
GRN_EXCESS_TOLERANCE_PERCENT=0
GRN_QC_FAIL_MANAGER_SIGNOFF_THRESHOLD_UNITS=20

# --- Service ---
PORT=4000
LOG_LEVEL=info
# Reverse-proxy hops in front of the API (1 = one load balancer). See DEPLOYMENT.md.
TRUST_PROXY_HOPS=1

# --- CORS (M11 - comma-separated origins allowed to call this API from a browser) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Wishlist / Cart (M12) ---
CART_GUEST_TTL_DAYS=30
CART_MAX_QUANTITY_PER_SKU=10

# --- Checkout / Payment (M13) ---
SHIPPING_DEFAULT_FLAT_AMOUNT=99
SHIPPING_DEFAULT_FREE_ABOVE_THRESHOLD=1999
COD_MAX_ORDER_VALUE_INR=5000

# --- Storefront (Next.js public runtime vars, apps/storefront) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# M27 (specs/26-seo.md): the absolute public origin used for canonical
# URLs, sitemap.xml, and robots.txt's sitemap reference.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Product pages are cached for up to 30 seconds. When both are set, the
# API asks the storefront to drop a product's page after publish,
# unpublish, archive, media or price changes. The secret is shared by
# the API and the storefront (server-only, never NEXT_PUBLIC_); use a
# random value of at least 32 characters in production.
# STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate/product
# STOREFRONT_REVALIDATE_SECRET=
# Search and filtered listings are always crawlable but never indexed on
# previews: set SITE_INDEXING=enabled only on the real production storefront.
# SITE_INDEXING=enabled

# --- Analytics and Meta (LR-003). Off until set; consent-gated in the browser. ---
# Public IDs (browser tags):
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Server-side events (commerce-api only - never NEXT_PUBLIC_):
# GA4_MEASUREMENT_ID=G-XXXXXXX
# GA4_API_SECRET=
# META_PIXEL_ID=000000000000000
# META_CAPI_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=TEST12345   # sends to Events Manager > Test events only
# STOREFRONT_PUBLIC_URL=https://www.example.com

# --- Scheduled maintenance (LR-006) ---
# MAINTENANCE_LEASE_SECONDS=120
# Failing-job alerts and recoveries are POSTed here (JSON with a `text` field).
# Required in production unless MAINTENANCE_ALERT_LOG_ONLY=true.
# MAINTENANCE_ALERT_WEBHOOK_URL=
# MAINTENANCE_ALERT_LOG_ONLY=false

# --- Seed (dev/test only - never used in production) ---
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
